# Copy to .env and fill in what you have. Anything left blank runs on demo data.

# ---------------------------------------------------------------- core
OPSDECK_ENV_NAME=local            # shown in the header; "prod" turns it red
OPSDECK_AUTH_MODE=local           # local (laptop, you are admin) | proxy (behind oauth2-proxy)
OPSDECK_DEMO=auto                 # auto: unconfigured tools use demo data | off: hide them | on: all demo
OPSDECK_ENABLE_WRITES=false       # true allows confirmed actions against LIVE systems
# OPSDECK_SECRET=                 # signs action confirmations; set a fixed value when running >1 replica
# OPSDECK_CA_BUNDLE=/etc/ssl/corp-ca.pem   # corporate proxy / private CA bundle
# OPSDECK_HOST=127.0.0.1
# OPSDECK_PORT=8080
# proxy mode only: comma-separated emails ("*" = everyone)
# OPSDECK_ADMINS=you@acme.com
# OPSDECK_OPERATORS=sre1@acme.com,sre2@acme.com
# OPSDECK_DEFAULT_ROLE=viewer

# ---------------------------------------------------------------- AI (any or all providers; users pick per chat)
OPSDECK_LLM_PROVIDER=anthropic    # default: anthropic | bedrock | openai | gemini | ollama | none
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Claude on Bedrock (uses the AWS credential chain):
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=<the Claude model or inference-profile ID enabled in your Bedrock account>
# OpenAI, or any OpenAI-compatible server (vLLM, LiteLLM, LM Studio, OpenRouter):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=<model id>
# Azure OpenAI (OPENAI_MODEL = your deployment name):
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# Google Gemini:
# GEMINI_API_KEY=
# GEMINI_MODEL=<model id>
# Ollama (local / air-gapped):
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3
# OPSDECK_LLM_MAX_STEPS=8         # tool calls per question

# ---------------------------------------------------------------- widgets
# OPSDECK_WIDGET_PYTHON=approval  # approval: admin approves each data.py version | off | trusted (dev only)
# OPSDECK_WIDGET_AUTHOR_ROLE=operator
# OPSDECK_WIDGET_WATCH=true       # hot-reload widgets when files change on disk

# ---------------------------------------------------------------- Kubernetes + Flux
K8S_ENABLED=false                 # true = use your kubeconfig (in-cluster is detected automatically)
# K8S_CONTEXT=prod-eks
# K8S_NAMESPACES=payments,checkout,search,flux-system   # restrict what the console can see/touch
# FLUX_NAMESPACE=flux-system

# ---------------------------------------------------------------- Argo CD
ARGOCD_URL=
ARGOCD_TOKEN=

# ---------------------------------------------------------------- Jenkins
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=
# JENKINS_DEFAULT_FOLDER=team

# ---------------------------------------------------------------- Artifactory
ARTIFACTORY_URL=                  # e.g. https://acme.jfrog.io/artifactory
ARTIFACTORY_TOKEN=
# ARTIFACTORY_DEFAULT_REPO=docker-local

# ---------------------------------------------------------------- AWS (credential chain: AWS_PROFILE, SSO, instance role, IRSA)
AWS_REGIONS=                      # e.g. us-east-1,us-west-2
# AWS_PROFILE=prod-readonly

# ---------------------------------------------------------------- Prisma Cloud
PRISMA_URL=                       # e.g. https://api.prismacloud.io
PRISMA_ACCESS_KEY=
PRISMA_SECRET_KEY=

# ---------------------------------------------------------------- Jira
JIRA_URL=                         # https://acme.atlassian.net or https://jira.acme.com
JIRA_USER=                        # Cloud: your email. Data Center: leave empty and use a PAT below
JIRA_TOKEN=
# JIRA_DEFAULT_JQL=project = OPS AND statusCategory != Done ORDER BY priority DESC
# JIRA_INCIDENT_JQL=project = OPS AND issuetype = Incident AND statusCategory != Done

# ---------------------------------------------------------------- Confluence
CONFLUENCE_URL=                   # https://acme.atlassian.net/wiki or https://wiki.acme.com
CONFLUENCE_USER=
CONFLUENCE_TOKEN=
# CONFLUENCE_DEFAULT_SPACE=SRE
# CONFLUENCE_DEFAULT_QUERY=runbook

# ---------------------------------------------------------------- GitHub (code, PRs, Actions)
GITHUB_TOKEN=                     # fine-grained token; contents+pull requests write only if PRs should be opened
# GITHUB_ORG=acme
# GITHUB_API_URL=https://ghe.acme.com/api/v3   # GitHub Enterprise Server
# GITHUB_DEFAULT_REPO=acme/payments-worker

# ---------------------------------------------------------------- PagerDuty
PAGERDUTY_TOKEN=
# PAGERDUTY_FROM=you@acme.com     # required for ack/resolve/notes
# PAGERDUTY_API_URL=https://api.eu.pagerduty.com

# ---------------------------------------------------------------- Prometheus / Mimir / Thanos + Alertmanager
PROMETHEUS_URL=
# PROMETHEUS_TOKEN=               # or PROMETHEUS_USER + PROMETHEUS_PASSWORD
# PROMETHEUS_ORG_ID=              # X-Scope-OrgID for multi-tenant Mimir
# ALERTMANAGER_URL=

# ---------------------------------------------------------------- Grafana, Loki, Tempo
GRAFANA_URL=
GRAFANA_TOKEN=                    # service account token, Viewer
LOKI_URL=
# LOKI_TOKEN= / LOKI_USER= + LOKI_PASSWORD= / LOKI_ORG_ID=
TEMPO_URL=
# TEMPO_TOKEN= / TEMPO_USER= + TEMPO_PASSWORD= / TEMPO_ORG_ID=

# ---------------------------------------------------------------- Datadog
DD_API_KEY=
DD_APP_KEY=
# DD_SITE=datadoghq.com

# ---------------------------------------------------------------- New Relic
NEW_RELIC_API_KEY=                # User key
NEW_RELIC_ACCOUNT_ID=
# NEW_RELIC_REGION=US             # or EU

# ---------------------------------------------------------------- Rancher (all managed clusters)
RANCHER_URL=
RANCHER_TOKEN=                    # token-xxxxx:yyyyy

# ---------------------------------------------------------------- Prisma Cloud Compute (image CVEs)
PRISMA_COMPUTE_URL=               # Compute console path from Manage > System > Utilities
# PRISMA_COMPUTE_ACCESS_KEY= / PRISMA_COMPUTE_SECRET_KEY=   (default: PRISMA_ACCESS_KEY / PRISMA_SECRET_KEY)

# ---------------------------------------------------------------- CVE intel (NVD, EPSS, CISA KEV, OSV: public APIs)
CVE_INTEL_ENABLED=false
# NVD_API_KEY=                    # optional, raises NVD rate limits

# ---------------------------------------------------------------- HolmesGPT (optional second-opinion agent)
# HOLMES_URL=http://localhost:5050
